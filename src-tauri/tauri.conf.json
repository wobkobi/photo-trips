{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pic Cabinet",
  "version": "../package.json",
  "identifier": "com.wobkobi.phototrips",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pic Cabinet",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "To the Point Tech",
    "copyright": "Copyright © 2026 To the Point Tech",
    "homepage": "https://www.tothepoint.co.nz",
    "licenseFile": "../LICENSE",
    "shortDescription": "A photo library that sorts photos into year, month and trip folders",
    "resources": {
      "resources/exiftool/": "resources/exiftool/",
      "../LICENSE": "LICENSE.txt",
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NUE5MjBGM0QzRTZFRTQKUldUa2JqNDlENUphR1JtdFRBRzY2V2Y4QTlyZkpDWHNudkVXK3ZOVVMvMERiQU1HZTJsY0lOTzQK",
      "endpoints": [
        "https://github.com/wobkobi/pic-cabinet/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
